<template>
  <div class="page">

    <div class="memo" if="{{mode === 'memo'}}">

      <div class="header">
        <text class="title">速記</text>
        <text class="count">{{notes.length}} / 12</text>
      </div>

      <input
        class="search"
        type="text"
        placeholder="搜尋筆記"
        value="{{searchQuery}}"
        @change="searchNotes"
      />

      <div class="filters">
        <input class="filter" type="button" value="全部" @click="showAll" />
        <input class="filter" type="button" value="最愛" @click="showFavorites" />
        <input class="filter" type="button" value="最近" @click="showRecent" />
      </div>

      <input
        class="new-note"
        type="button"
        value="＋ 新增速記"
        @click="openKeyboard"
      />

      <text class="hint" if="{{displayNotes.length === 0}}">
        {{emptyMessage}}
      </text>

      <list
        class="list"
        if="{{notes.length > 0}}"
      >
        <list-item
          class="item"
          for="{{displayNotes}}"
          type="list"
          tid="id"
          @click="editNote($item)"
        >
          <div class="note-line">
            <text class="note">{{$item.favorite ? '★ ' : ''}}{{$item.text}}</text>
            <input
              class="favorite"
              type="button"
              value="{{$item.favorite ? '★' : '☆'}}"
              @click="toggleFavorite($item)"
            />
          </div>
          <text class="time">{{$item.time}}</text>
        </list-item>
      </list>

      <text class="status" if="{{status}}">{{status}}</text>

    </div>


    <div
      class="keyboard-page"
      if="{{mode === 'keyboard'}}"
    >

      <div class="input-box">
        <text class="typed">{{draft || imeBuffer || '輸入備忘…'}}</text>
      </div>

      <div class="mode-row">
        <input class="mode-btn" type="button" value="ABC" @click="setABC" />
        <input class="mode-btn" type="button" value="拼音" @click="setPinyin" />
        <input class="mode-btn" type="button" value="注音" @click="setZhuyin" />
        <input class="script-btn" type="button" value="{{scriptMode === 'trad' ? '繁' : '簡'}}" @click="toggleScript" />
      </div>

      <div class="candidate-row" if="{{imeMode !== 'abc' && candidates.length > 0}}">
        <input
          class="candidate"
          type="button"
          for="{{candidates}}"
          value="{{$item}}"
          @click="chooseCandidate($item)"
        />
      </div>

      <text class="ime-hint" if="{{imeMode !== 'abc' && imeBuffer}}">
        {{imeBuffer}}
      </text>

      <div class="tools">
        <input class="tool cancel" type="button" value="取消" @click="cancelEdit" />
        <input class="tool clear" type="button" value="清除" @click="clearDraft" />
        <input class="tool done" type="button" value="{{isSaving ? '儲存中' : '儲存'}}" @click="saveDraft" />
      </div>

      <text class="status" if="{{status}}">{{status}}</text>

      <input class="delete" type="button" if="{{editingId && !deleteArmed}}" value="刪除這則備忘" @click="requestDelete" />
      <input class="delete confirm-delete" type="button" if="{{editingId && deleteArmed}}" value="再按一次確認刪除" @click="deleteNote" />

      <div class="keys qwerty-keys" if="{{imeMode === 'abc' || imeMode === 'pinyin'}}">
        <div class="key-row">
          <input class="key" type="button" value="Q" @click="typeKey" />
          <input class="key" type="button" value="W" @click="typeKey" />
          <input class="key" type="button" value="E" @click="typeKey" />
          <input class="key" type="button" value="R" @click="typeKey" />
          <input class="key" type="button" value="T" @click="typeKey" />
        </div>
        <div class="key-row">
          <input class="key" type="button" value="Y" @click="typeKey" />
          <input class="key" type="button" value="U" @click="typeKey" />
          <input class="key" type="button" value="I" @click="typeKey" />
          <input class="key" type="button" value="O" @click="typeKey" />
          <input class="key" type="button" value="P" @click="typeKey" />
        </div>
        <div class="key-row">
          <input class="key" type="button" value="A" @click="typeKey" />
          <input class="key" type="button" value="S" @click="typeKey" />
          <input class="key" type="button" value="D" @click="typeKey" />
          <input class="key" type="button" value="F" @click="typeKey" />
          <input class="key" type="button" value="G" @click="typeKey" />
        </div>
        <div class="key-row">
          <input class="key" type="button" value="H" @click="typeKey" />
          <input class="key" type="button" value="J" @click="typeKey" />
          <input class="key" type="button" value="K" @click="typeKey" />
          <input class="key" type="button" value="L" @click="typeKey" />
        </div>
        <div class="key-row">
          <input class="key" type="button" value="Z" @click="typeKey" />
          <input class="key" type="button" value="X" @click="typeKey" />
          <input class="key" type="button" value="C" @click="typeKey" />
          <input class="key" type="button" value="V" @click="typeKey" />
          <input class="key" type="button" value="B" @click="typeKey" />
        </div>
        <div class="key-row">
          <input class="key" type="button" value="N" @click="typeKey" />
          <input class="key" type="button" value="M" @click="typeKey" />
        </div>
      </div>

      <div class="keys zhuyin-keys" if="{{imeMode === 'zhuyin'}}">
        <div class="key-row zhuyin-row"><input class="zkey" type="button" value="ㄅ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄆ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄇ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄈ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄉ" @click="typeZhuyin" /></div>
        <div class="key-row zhuyin-row"><input class="zkey" type="button" value="ㄊ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄋ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄌ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄍ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄎ" @click="typeZhuyin" /></div>
        <div class="key-row zhuyin-row"><input class="zkey" type="button" value="ㄏ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄐ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄑ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄒ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄓ" @click="typeZhuyin" /></div>
        <div class="key-row zhuyin-row"><input class="zkey" type="button" value="ㄔ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄕ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄖ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄗ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄘ" @click="typeZhuyin" /></div>
        <div class="key-row zhuyin-row"><input class="zkey" type="button" value="ㄙ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄚ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄛ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄜ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄝ" @click="typeZhuyin" /></div>
        <div class="key-row zhuyin-row"><input class="zkey" type="button" value="ㄞ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄟ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄠ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄡ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄢ" @click="typeZhuyin" /></div>
        <div class="key-row zhuyin-row"><input class="zkey" type="button" value="ㄣ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄤ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄥ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄦ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄧ" @click="typeZhuyin" /></div>
        <div class="key-row zhuyin-row"><input class="zkey" type="button" value="ㄨ" @click="typeZhuyin" /><input class="zkey" type="button" value="ㄩ" @click="typeZhuyin" /></div>
        <div class="tone-row"><input class="tone" type="button" value="˙" @click="typeZhuyin" /><input class="tone" type="button" value="ˊ" @click="typeZhuyin" /><input class="tone" type="button" value="ˇ" @click="typeZhuyin" /><input class="tone" type="button" value="ˋ" @click="typeZhuyin" /></div>
      </div>

      <div class="keyboard-actions">
        <input class="space" type="button" value="空白" @click="space" />
        <input class="backspace" type="button" value="⌫" @click="backspace" />
      </div>
    </div>

  </div>
</template>


<script>
import storage from '@system.storage'

const KEY = 'band-memo.notes.v1'
const MAX_NOTES = 12
const MAX_BYTES = 4096
const MAX_TEXT_LENGTH = 24

function safeNotes(raw) {
  if (
    typeof raw !== 'string' ||
    raw.length > MAX_BYTES
  ) {
    return []
  }

  try {
    const items = JSON.parse(raw)

    if (!Array.isArray(items)) {
      return []
    }

    const ids = {}

    return items.reduce(function (result, item) {

      if (
        !item ||
        typeof item !== 'object' ||
        typeof item.id !== 'string' ||
        ids[item.id]
      ) {
        return result
      }

      if (
        typeof item.text !== 'string' ||
        item.text.length < 1 ||
        item.text.length > MAX_TEXT_LENGTH
      ) {
        return result
      }

      if (
        typeof item.time !== 'string' ||
        item.time.length > 16 ||
        result.length >= MAX_NOTES
      ) {
        return result
      }

      ids[item.id] = true

      result.push({
        id: item.id,
        text: item.text,
        time: item.time,
        favorite: !!item.favorite,
        lastUsed: typeof item.lastUsed === 'number' ? item.lastUsed : 0
      })

      return result

    }, [])

  } catch (error) {
    return []
  }
}

function formatTime(now) {
  const month = String(now.getMonth() + 1).padStart(2, '0')
  const day = String(now.getDate()).padStart(2, '0')
  const hour = String(now.getHours()).padStart(2, '0')
  const minute = String(now.getMinutes()).padStart(2, '0')

  return month + '/' + day + ' ' + hour + ':' + minute
}


const PINYIN = {
  ni:'你妳尼呢泥逆', hao:'好號号浩豪', wo:'我握窩窝喔', shi:'是時时事市十試试', de:'的得德地',
  bu:'不部步補补布', yi:'一以已意衣醫医', ge:'個个各歌哥格', ren:'人任認认仁', zai:'在再載载',
  jian:'見见間间件建簡简', tian:'天田填甜', qi:'起氣气七其期', ta:'他她它塔', men:'們们門门',
  ma:'嗎吗馬马嘛', ba:'把八爸吧', da:'大打達达', xiao:'小笑校消', xue:'學学雪', sheng:'生聲声升',
  ri:'日', yue:'月越約约', kai:'開开', guan:'關关觀观', ji:'記记機机幾几己', zhu:'住主助注',
  wang:'忘網网王', xin:'心新信', xi:'喜系細细西', huan:'歡欢還还環环', ying:'英應应影',
  yu:'語语雨魚鱼', wen:'文問问', hua:'話话花畫画', shui:'水誰谁睡', huo:'活火或', shen:'什神身深',
  me:'麼么么', zi:'字自子', ci:'次此詞词', ming:'明名命', bai:'白百', zhong:'中種种重',
  guo:'國国果過过', tai:'臺台太態态', wan:'灣湾完晚玩', xie:'寫写謝谢谢', zhe:'這这者著着',
  dao:'到道倒', le:'了樂乐', ye:'也業业夜', he:'和喝何', cheng:'成城程', du:'讀读度都',
  shu:'書书數数', ke:'可課课科', yao:'要藥药', xiang:'想相向像', kan:'看', ting:'聽听',
  shuo:'說说', liao:'聊料', dian:'點点電电店', nao:'腦脑', zhi:'知只紙纸直', chi:'吃持',
  fan:'飯饭反返', jin:'今近進进', zao:'早造', an:'安', quan:'全權权', lin:'林', lao:'老',
  shi2:'師师時时', tong:'同通統统', peng:'朋', you:'友有又', bei:'備备北', de2:'的得地',
  ju:'句具', chang:'長长常場场', mei:'每美沒没', xu:'需許许', juan:'卷', ai:'愛爱',
  xian:'先現现', tiao:'條条', jia:'家加假', shou:'手首', zheng:'正整', li:'理', fang:'方房',
  bian:'便變变', xing:'行形興兴', lu:'路', di:'地第弟', er:'二兒儿', san:'三', si:'四', wu:'五',
  liu:'六', jiu:'九'
};

const PHRASES = {
  nihao:'你好', xiexie:'謝謝', zaijian:'再見', jintian:'今天', tianqi:'天氣', xiaomi:'小米',
  suji:'速記', woai:'我愛', keyi:'可以', meiyou:'沒有', xianzai:'現在', chifan:'吃飯',
  shangxue:'上學', laoshi:'老師', tongxue:'同學', zhongguo:'中國', taiwan:'台灣',
  beizhu:'備註', shuru:'輸入', shanchu:'刪除', baocun:'保存', shezhi:'設置'
};

const ZHUYIN_TO_PINYIN = {
  'ㄋㄧ':'ni','ㄏㄠ':'hao','ㄨㄛ':'wo','ㄕ':'shi','ㄕˋ':'shi','ㄉㄜ':'de','ㄅㄨ':'bu','ㄧ':'yi',
  'ㄍㄜ':'ge','ㄖㄣ':'ren','ㄗㄞ':'zai','ㄐㄧㄢ':'jian','ㄊㄧㄢ':'tian','ㄑㄧ':'qi','ㄊㄚ':'ta',
  'ㄇㄣ':'men','ㄇㄚ':'ma','ㄅㄚ':'ba','ㄉㄚ':'da','ㄒㄧㄠ':'xiao','ㄒㄩㄝ':'xue','ㄕㄥ':'sheng',
  'ㄖˋ':'ri','ㄩㄝ':'yue','ㄎㄞ':'kai','ㄍㄨㄢ':'guan','ㄐㄧ':'ji','ㄓㄨ':'zhu','ㄨㄤ':'wang',
  'ㄒㄧㄣ':'xin','ㄏㄨㄢ':'huan','ㄧㄥ':'ying','ㄩˇ':'yu','ㄨㄣ':'wen','ㄏㄨㄚ':'hua','ㄕㄨㄟ':'shui',
  'ㄏㄨㄛ':'huo','ㄕㄣ':'shen','ㄇㄜ':'me','ㄗ':'zi','ㄘ':'ci','ㄇㄧㄥ':'ming','ㄅㄞ':'bai','ㄓㄨㄥ':'zhong',
  'ㄍㄨㄛ':'guo','ㄊㄞ':'tai','ㄨㄢ':'wan','ㄒㄧㄝ':'xie','ㄓㄜ':'zhe','ㄉㄠ':'dao','ㄌㄜ':'le',
  'ㄧㄝ':'ye','ㄏㄜ':'he','ㄔㄥ':'cheng','ㄉㄨ':'du','ㄕㄨ':'shu','ㄎㄜ':'ke','ㄧㄠ':'yao','ㄒㄧㄤ':'xiang',
  'ㄎㄢ':'kan','ㄊㄧㄥ':'ting','ㄕㄨㄛ':'shuo','ㄉㄧㄢ':'dian','ㄋㄠ':'nao','ㄓ':'zhi','ㄔ':'chi',
  'ㄈㄢ':'fan','ㄐㄧㄣ':'jin','ㄗㄠ':'zao','ㄢ':'an','ㄑㄩㄢ':'quan','ㄊㄨㄥ':'tong','ㄆㄥ':'peng',
  'ㄧㄡ':'you','ㄅㄟ':'bei','ㄐㄩ':'ju','ㄓㄤ':'zhang','ㄇㄟ':'mei','ㄒㄩ':'xu','ㄞ':'ai','ㄒㄧㄢ':'xian',
  'ㄊㄧㄠ':'tiao','ㄐㄧㄚ':'jia','ㄕㄡ':'shou','ㄓㄥ':'zheng','ㄈㄤ':'fang','ㄅㄧㄢ':'bian','ㄒㄧㄥ':'xing',
  'ㄌㄨ':'lu','ㄉㄧ':'di','ㄦ':'er','ㄙㄢ':'san','ㄙ':'si','ㄨ':'wu','ㄌㄧㄡ':'liu','ㄐㄧㄡ':'jiu'
};

const SIMPLE_MAP = {
  '時':'时','間':'间','見':'见','試':'试','個':'个','認':'认','載':'载','開':'开','關':'关','觀':'观',
  '記':'记','機':'机','幾':'几','醫':'医','網':'网','細':'细','歡':'欢','還':'还','環':'环','應':'应',
  '語':'语','問':'问','話':'话','誰':'谁','畫':'画','學':'学','與':'与','這':'这','著':'着','樂':'乐',
  '業':'业','讀':'读','書':'书','數':'数','課':'课','藥':'药','說':'说','點':'点','電':'电','腦':'脑',
  '紙':'纸','飯':'饭','進':'进','聽':'听','條':'条','愛':'爱','現':'现','場':'场','長':'长','變':'变',
  '興':'兴','師':'师','統':'统','備':'备','臺':'台','灣':'湾','國':'国','刪':'删','輸':'输','儲':'储',
  '選':'选','擇':'择','簡':'简','測':'测','鍵':'键','盤':'盘','後':'后','體':'体','們':'们','門':'门',
  '嗎':'吗','馬':'马','麼':'么','謝':'谢','寫':'写','憶':'忆','當':'当','註':'注','設':'设'
};

export default {

  private: {
    notes: [],
    displayNotes: [],
    searchQuery: '',
    filterMode: 'all',
    emptyMessage: '點選新增，輸入你的備忘',
    mode: 'memo',
    draft: '',
    imeMode: 'abc',
    scriptMode: 'trad',
    imeBuffer: '',
    candidates: [],
    editingId: '',
    deleteArmed: false,
    isSaving: false,
    status: ''
  },


  onInit() {
    const self = this

    storage.get({
      key: KEY,
      default: '[]',

      success(data) {

        self.notes = safeNotes(
          typeof data === 'string'
            ? data
            : data && data.data
        )
        self.refreshList()

      },

      fail() {
        self.notes = []
        self.refreshList()
      }
    })
  },


  refreshList() {
    let items = this.notes.slice()

    if (this.filterMode === 'favorites') {
      items = items.filter(note => note.favorite)
    } else if (this.filterMode === 'recent') {
      items.sort(function(a, b) {
        return (b.lastUsed || 0) - (a.lastUsed || 0)
      })
    } else {
      items.sort(function(a, b) {
        if (!!b.favorite !== !!a.favorite) {
          return b.favorite ? 1 : -1
        }
        return (b.lastUsed || 0) - (a.lastUsed || 0)
      })
    }

    const query = this.searchQuery.trim().toLowerCase()
    if (query) {
      items = items.filter(note =>
        note.text.toLowerCase().indexOf(query) !== -1
      )
    }

    this.displayNotes = items
    this.emptyMessage = query
      ? '找不到符合的筆記'
      : this.filterMode === 'favorites'
        ? '目前沒有最愛筆記'
        : this.filterMode === 'recent'
          ? '目前沒有最近使用的筆記'
          : '點選新增，輸入你的備忘'
  },

  searchNotes(event) {
    this.searchQuery = event && typeof event.value === 'string'
      ? event.value
      : ''
    this.refreshList()
  },

  showAll() {
    this.filterMode = 'all'
    this.refreshList()
  },

  showFavorites() {
    this.filterMode = 'favorites'
    this.refreshList()
  },

  showRecent() {
    this.filterMode = 'recent'
    this.refreshList()
  },

  toggleFavorite(item) {
    if (!item || typeof item.id !== 'string' || this.isSaving) {
      return
    }

    const nextNotes = this.notes.map(note => {
      if (note.id !== item.id) {
        return note
      }
      return {
        id: note.id,
        text: note.text,
        time: note.time,
        favorite: !note.favorite,
        lastUsed: note.lastUsed || 0
      }
    })

    this.saveMetadata(nextNotes, '已更新最愛')
  },

  saveMetadata(nextNotes, successMessage) {
    const self = this
    storage.set({
      key: KEY,
      value: JSON.stringify(nextNotes),
      success() {
        self.notes = nextNotes
        self.refreshList()
        self.status = successMessage
      },
      fail() {
        self.status = '儲存失敗，請再試一次'
      }
    })
  },

  touchNote(id) {
    if (!id) {
      return
    }

    const now = Date.now()
    const nextNotes = this.notes.map(note => {
      if (note.id !== id) {
        return note
      }
      return {
        id: note.id,
        text: note.text,
        time: note.time,
        favorite: !!note.favorite,
        lastUsed: now
      }
    })

    this.notes = nextNotes
    this.refreshList()
    storage.set({
      key: KEY,
      value: JSON.stringify(nextNotes)
    })
  },

  toSimplified(text) {
    return text.split('').map(function(ch) {
      return SIMPLE_MAP[ch] || ch
    }).join('')
  },

  getCandidates(buffer) {
    const key = buffer.toLowerCase()
    let list = []

    if (PHRASES[key]) {
      list.push(PHRASES[key])
    }

    if (PINYIN[key]) {
      list = list.concat(PINYIN[key].split(''))
    }

    if (this.scriptMode === 'simp') {
      list = list.map(item => this.toSimplified(item))
    }

    return list.slice(0, 8)
  },

  refreshCandidates() {
    if (this.imeMode === 'abc' || !this.imeBuffer) {
      this.candidates = []
      return
    }

    if (this.imeMode === 'pinyin') {
      this.candidates = this.getCandidates(this.imeBuffer)
      return
    }

    const normalized = this.imeBuffer.replace(/[˙ˊˇˋ]/g, '')
    const pinyin = ZHUYIN_TO_PINYIN[this.imeBuffer] || ZHUYIN_TO_PINYIN[normalized] || ''
    this.candidates = pinyin ? this.getCandidates(pinyin) : []
  },

  setABC() {
    this.setInputMode('abc')
  },

  setPinyin() {
    this.setInputMode('pinyin')
  },

  setZhuyin() {
    this.setInputMode('zhuyin')
  },

  setInputMode(mode) {
    if (mode !== 'abc' && mode !== 'pinyin' && mode !== 'zhuyin') {
      return
    }

    this.imeMode = mode
    this.imeBuffer = ''
    this.candidates = []
    this.status = ''
  },

  toggleScript() {
    this.scriptMode = this.scriptMode === 'trad' ? 'simp' : 'trad'
    this.refreshCandidates()
  },

  chooseCandidate(candidate) {
    if (typeof candidate !== 'string' || !candidate) {
      return
    }

    if (this.draft.length + candidate.length > MAX_TEXT_LENGTH) {
      return
    }

    this.draft += candidate
    this.imeBuffer = ''
    this.candidates = []
  },

  openKeyboard() {
    this.mode = 'keyboard'
    this.draft = ''
    this.imeMode = 'abc'
    this.scriptMode = 'trad'
    this.imeBuffer = ''
    this.candidates = []
    this.editingId = ''
    this.deleteArmed = false
    this.status = ''
  },


  typeKey(event) {
    if (!event || typeof event.value !== 'string' || !event.value) {
      return
    }

    const value = event.value

    if (this.imeMode === 'abc') {
      if (this.draft.length < MAX_TEXT_LENGTH) {
        this.draft += value
      }
      return
    }

    if (this.imeBuffer.length < 12) {
      this.imeBuffer += value
      this.refreshCandidates()
    }
  },


  space() {
    if (this.imeMode !== 'abc' && this.imeBuffer) {
      if (this.candidates.length > 0) {
        this.chooseCandidate(this.candidates[0])
      } else {
        this.imeBuffer = ''
        this.candidates = []
      }
      return
    }

    if (this.draft.length < MAX_TEXT_LENGTH) {
      this.draft += ' '
    }
  },


  backspace() {
    if (this.imeMode !== 'abc' && this.imeBuffer) {
      this.imeBuffer = this.imeBuffer.slice(0, -1)
      this.refreshCandidates()
      return
    }

    this.draft = this.draft.slice(0, -1)
  },


  clearDraft() {
    this.draft = ''
    this.imeBuffer = ''
    this.candidates = []
  },


  editNote(note) {
    if (!note || typeof note.id !== 'string') {
      return
    }

    this.mode = 'keyboard'
    this.draft = note.text
    this.imeMode = 'abc'
    this.imeBuffer = ''
    this.candidates = []
    this.editingId = note.id
    this.touchNote(note.id)
    this.deleteArmed = false
    this.status = ''
  },


  cancelEdit() {
    if (this.isSaving) {
      return
    }

    this.mode = 'memo'
    this.draft = ''
    this.imeBuffer = ''
    this.candidates = []
    this.editingId = ''
    this.deleteArmed = false
    this.status = ''
  },


  requestDelete() {
    if (this.isSaving || !this.editingId) {
      return
    }

    this.deleteArmed = true
    this.status = '再按一次確認刪除'
  },


  saveDraft() {

    if (this.isSaving) {
      return
    }

    let text = this.draft

    if (this.imeMode !== 'abc' && this.imeBuffer && this.candidates.length > 0) {
      text += this.candidates[0]
    }

    text = text.trim()

    if (!text) {
      return
    }

    const existing = this.notes.filter(note => note.id === this.editingId)[0]
    let nextNotes

    if (existing) {
      nextNotes = this.notes.map(note => {
        if (note.id !== this.editingId) {
          return note
        }

        return {
          id: note.id,
          text: text,
          time: formatTime(new Date()),
          favorite: !!note.favorite,
          lastUsed: Date.now()
        }
      })
    } else {
      const now = new Date()
      const note = {
        id: String(now.getTime()) + '-' + String(this.notes.length),
        text: text,
        time: formatTime(now),
        favorite: false,
        lastUsed: now.getTime()
      }

      nextNotes = [note].concat(this.notes).slice(0, MAX_NOTES)
    }

    this.saveNotes(nextNotes, '已儲存')
  },


  deleteNote() {
    if (this.isSaving || !this.editingId || !this.deleteArmed) {
      return
    }

    const nextNotes = this.notes.filter(note => note.id !== this.editingId)
    this.saveNotes(nextNotes, '已刪除')
  },


  saveNotes(nextNotes, successMessage) {
    const self = this

    this.isSaving = true
    this.status = '儲存中…'

    storage.set({

      key: KEY,

      value: JSON.stringify(
        nextNotes
      ),

      success() {
        self.notes = nextNotes
        self.refreshList()
        self.isSaving = false
        self.mode = 'memo'
        self.draft = ''
        self.imeBuffer = ''
        self.candidates = []
        self.editingId = ''
        self.deleteArmed = false
        self.status = successMessage
      },

      fail() {
        self.isSaving = false
        self.status = '儲存失敗，請再試一次'
      }

    })

  }

}
</script>


