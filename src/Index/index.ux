  '語':'语','問':'问','話':'话','誰':'谁','畫':'画','學':'学','與':'与','這':'这','著':'着','樂':'乐',
  '業':'业','讀':'读','書':'书','數':'数','課':'课','藥':'药','說':'说','點':'点','電':'电','腦':'脑',
  '紙':'纸','飯':'饭','進':'进','聽':'听','條':'条','愛':'爱','現':'现','場':'场','長':'长','變':'变',
  '興':'兴','師':'师','統':'统','備':'备','臺':'台','灣':'湾','國':'国','刪':'删','輸':'输','儲':'储',
  '選':'选','擇':'择','簡':'简','測':'测','鍵':'键','盤':'盘','後':'后','體':'体','們':'们','門':'门',
  '嗎':'吗','馬':'马','麼':'么','謝':'谢','寫':'写','憶':'忆','當':'当','註':'注','設':'设'
};

const TRAD_MAP = {}
Object.keys(SIMPLE_MAP).forEach(function(ch) {
  const simple = SIMPLE_MAP[ch]
  if (simple && !TRAD_MAP[simple]) {
    TRAD_MAP[simple] = ch
  }
});

export default {

  private: {
    notes: [],
    displayNotes: [],
    searchQuery: '',
    filterMode: 'all',
    categoryFilter: 'all',
    category: 'other',
    categoryLabel: '其他',
    emptyMessage: '點選新增，輸入你的備忘',
    mode: 'memo',
    draft: '',
    imeMode: 'abc',
    scriptMode: 'trad',
    imeBuffer: '',
    candidates: [],
    editingId: '',
    deleteArmed: false,
    isSaving: false,
    status: '',
    settings: {
      imeMode: 'abc',
      scriptMode: 'trad',
      candidateLimit: DEFAULT_CANDIDATE_LIMIT
    },
    defaultImeLabel: 'ABC',
    defaultScriptLabel: '繁體',
    candidateLimitLabel: '6 個',
    clearAllLabel: '清除全部',
    confirmClearAll: false
  },


  onInit() {
    const self = this

    storage.get({
      key: KEY,
      default: '[]',

      success(data) {

        self.commitNotes(
          safeNotes(
            typeof data === 'string'
              ? data
              : data && data.data
          )
        )

      },

      fail() {
        self.commitNotes([])
      }
    })

    storage.get({
      key: SETTINGS_KEY,
      default: '{}',

      success(data) {
        self.settings = safeSettings(
          typeof data === 'string'
            ? data
            : data && data.data
        )
        self.applySettingLabels()
      },

      fail() {
        self.settings = safeSettings('')
        self.applySettingLabels()
      }
    })
  },


  commitNotes(nextNotes) {
    const safe = safeNotes(JSON.stringify(nextNotes))

    if (!Array.isArray(safe)) {
      return
    }

    this.notes = safe
    this.refreshList()
  },

  refreshList() {
    let items = this.notes.slice()

    if (this.categoryFilter !== 'all') {
      items = items.filter(note => note.category === this.categoryFilter)
    }

    if (this.filterMode === 'favorites') {
      items = items.filter(note => note.favorite)
    } else if (this.filterMode === 'recent') {
      items.sort(function(a, b) {
        return (b.lastUsed || 0) - (a.lastUsed || 0)
      })
    } else {
      items.sort(function(a, b) {
        if (!!b.favorite !== !!a.favorite) {
          return b.favorite ? 1 : -1
        }
        return (b.lastUsed || 0) - (a.lastUsed || 0)
      })
    }

    const query = this.searchQuery.trim().toLowerCase()
    if (query) {
      items = items.filter(note =>
        note.text.toLowerCase().indexOf(query) !== -1
      )
    }

    this.displayNotes = items
    this.emptyMessage = query
      ? '找不到符合的筆記'
      : this.filterMode === 'favorites'
        ? '目前沒有最愛筆記'
        : this.filterMode === 'recent'
          ? '目前沒有最近使用的筆記'
          : '點選新增，輸入你的備忘'
  },

  searchNotes(event) {
    this.searchQuery = event && typeof event.value === 'string'
      ? event.value
      : ''
    this.refreshList()
  },

  showAll() {
    this.filterMode = 'all'
    this.refreshList()
  },

  showFavorites() {
    this.filterMode = 'favorites'
    this.refreshList()
  },

  showRecent() {
    this.filterMode = 'recent'
    this.refreshList()
  },

  toggleFavorite(item, event) {
    if (!item || typeof item.id !== 'string' || this.isSaving) {
      return
    }

    if (event && typeof event.stopPropagation === 'function') {
      event.stopPropagation()
    }

    const nextNotes = this.notes.map(note => {
      if (note.id !== item.id) {
        return note
      }
      return {
        id: note.id,
        text: note.text,
        time: note.time,
        favorite: !note.favorite,
        lastUsed: note.lastUsed || 0
      }
    })

    this.saveMetadata(nextNotes, '已更新最愛')
  },

  saveMetadata(nextNotes, successMessage) {
    if (this.isSaving) {
      return
    }

    const self = this
    this.isSaving = true
    this.status = '儲存中…'

    storage.set({
      key: KEY,
      value: JSON.stringify(nextNotes),
      success() {
        self.commitNotes(nextNotes)
        self.isSaving = false
        self.status = successMessage
      },
      fail() {
        self.isSaving = false
        self.status = '儲存失敗，請再試一次'
      }
    })
  },

  touchNote(id) {
    if (!id || this.isSaving) {
      return
    }

    const now = Date.now()
    const nextNotes = this.notes.map(note => {
      if (note.id !== id) {
        return note
      }
      return {
        id: note.id,
        text: note.text,
        time: note.time,
        favorite: !!note.favorite,
        lastUsed: now
      }
    })

    this.commitNotes(nextNotes)
    storage.set({
      key: KEY,
      value: JSON.stringify(nextNotes)
    })
  },

  toSimplified(text) {
    return String(text || '').split('').map(function(ch) {
      return SIMPLE_MAP[ch] || ch
    }).join('')
  },

  toTraditional(text) {
    return String(text || '').split('').map(function(ch) {
      return TRAD_MAP[ch] || ch
    }).join('')
  },

  getCandidates(buffer) {
    const key = String(buffer || '').toLowerCase()
    let list = []

    if (PHRASES[key]) {
      list.push(PHRASES[key])
    }

    if (PINYIN[key]) {
      list = list.concat(PINYIN[key].split(''))
    }

    if (this.scriptMode === 'simp') {
      list = list.map(item => this.toSimplified(item))
    } else {
      list = list.map(item => this.toTraditional(item))
    }

    const unique = []
    list.forEach(function(item) {
      if (unique.indexOf(item) === -1) {
        unique.push(item)
      }
    })

    return unique.slice(0, this.settings.candidateLimit)
  },

  refreshCandidates() {
    if (this.imeMode === 'abc' || !this.imeBuffer) {
      this.candidates = []
      return
    }

    if (this.imeMode === 'pinyin') {
      this.candidates = this.getCandidates(this.imeBuffer)
      return
    }

    const normalized = this.imeBuffer.replace(/[˙ˊˇˋ]/g, '')
    const pinyin = ZHUYIN_TO_PINYIN[this.imeBuffer] || ZHUYIN_TO_PINYIN[normalized] || ''
    this.candidates = pinyin ? this.getCandidates(pinyin) : []
  },

  applySettingLabels() {
    if (this.settings.imeMode === 'pinyin') {
      this.defaultImeLabel = '拼音'
    } else if (this.settings.imeMode === 'zhuyin') {
      this.defaultImeLabel = '注音'
    } else {
      this.defaultImeLabel = 'ABC'
    }

    this.defaultScriptLabel = this.settings.scriptMode === 'simp'
      ? '簡體'
      : '繁體'

    this.candidateLimitLabel = String(this.settings.candidateLimit) + ' 個'
    this.clearAllLabel = this.confirmClearAll ? '再按一次' : '清除全部'
  },


  saveSettings(message) {
    const self = this
    storage.set({
      key: SETTINGS_KEY,
      value: JSON.stringify(self.settings),

      success() {
        self.applySettingLabels()
        self.status = message
      },

      fail() {
        self.status = '設定儲存失敗'
      }
    })
  },


  openSettings() {
    this.mode = 'settings'
    this.confirmClearAll = false
    this.applySettingLabels()
    this.status = ''
  },


  closeSettings() {
    this.confirmClearAll = false
    this.mode = 'memo'
    this.status = ''
    this.refreshList()
  },


  cycleDefaultIme() {
    if (this.settings.imeMode === 'abc') {
      this.settings.imeMode = 'pinyin'
    } else if (this.settings.imeMode === 'pinyin') {
      this.settings.imeMode = 'zhuyin'
    } else {
      this.settings.imeMode = 'abc'
    }

    this.saveSettings('已更新預設輸入')
  },


  toggleDefaultScript() {
    this.settings.scriptMode = this.settings.scriptMode === 'trad'
      ? 'simp'
      : 'trad'

    this.saveSettings('已更新預設字體')
  },


  cycleCandidateLimit() {
    if (this.settings.candidateLimit === 4) {
      this.settings.candidateLimit = 6
    } else if (this.settings.candidateLimit === 6) {
      this.settings.candidateLimit = 8
    } else {
      this.settings.candidateLimit = 4
    }

    this.saveSettings('已更新候選字數')
  },


  resetSettings() {
    this.settings = {
      imeMode: 'abc',
      scriptMode: 'trad',
      candidateLimit: DEFAULT_CANDIDATE_LIMIT
    }
    this.confirmClearAll = false
    this.saveSettings('已恢復預設設定')
  },


  requestClearAllNotes() {
    if (!this.confirmClearAll) {
      this.confirmClearAll = true
      this.applySettingLabels()
      this.status = '再按一次確認清除全部'
      return
    }

    this.clearAllNotes()
  },


  clearAllNotes() {
    const self = this
    storage.set({
      key: KEY,
      value: '[]',

      success() {
        self.commitNotes([])
        self.confirmClearAll = false
        self.applySettingLabels()
        self.status = '已清除全部筆記'
      },

      fail() {
        self.status = '清除失敗，請再試一次'
      }
    })
  },


  setABC() {
    this.setInputMode('abc')
  },

  setPinyin() {
    this.setInputMode('pinyin')
  },

  setZhuyin() {
    this.setInputMode('zhuyin')
  },

  setInputMode(mode) {
    if (mode !== 'abc' && mode !== 'pinyin' && mode !== 'zhuyin') {
      return
    }

    this.imeMode = mode
    this.imeBuffer = ''
    this.candidates = []
    this.status = ''
  },

  toggleScript() {
    if (this.scriptMode === 'trad') {
      this.scriptMode = 'simp'
      this.draft = this.toSimplified(this.draft)
    } else {
      this.scriptMode = 'trad'
      this.draft = this.toTraditional(this.draft)
    }

    this.refreshCandidates()
  },

  chooseCandidate(candidate) {
    if (typeof candidate !== 'string' || !candidate) {
      return
    }

    const value = this.scriptMode === 'simp'
      ? this.toSimplified(candidate)
      : this.toTraditional(candidate)

    if (this.draft.length + value.length > MAX_TEXT_LENGTH) {
      return
    }

    this.draft += value
    this.imeBuffer = ''
    this.candidates = []
  },

  openKeyboard() {
    this.mode = 'keyboard'
    this.draft = ''
    this.imeMode = this.settings.imeMode
    this.scriptMode = this.settings.scriptMode
    this.imeBuffer = ''
    this.candidates = []
    this.editingId = ''
    this.deleteArmed = false
    this.status = ''
  },


  typeKey(value) {
    if (typeof value !== 'string' || !value) {
      return
    }

    if (this.imeMode === 'abc') {
      if (this.draft.length < MAX_TEXT_LENGTH) {
        this.draft += value
      }
      return
    }

    if (this.imeBuffer.length < 12) {
      this.imeBuffer += value
      this.refreshCandidates()
    }
  },


  typeZhuyin(value) {
    if (typeof value !== 'string' || !value) {
      return
    }

    if (this.imeMode !== 'zhuyin') {
      return
    }

    if (this.imeBuffer.length >= 12) {
      return
    }

    const tones = '˙ˊˇˋ'
    if (tones.indexOf(value) !== -1) {
      this.imeBuffer = this.imeBuffer.replace(/[˙ˊˇˋ]/g, '') + value
    } else {
      this.imeBuffer += value
    }

    this.refreshCandidates()
  },


  space() {
    if (this.imeMode !== 'abc' && this.imeBuffer) {
      if (this.candidates.length > 0) {
        this.chooseCandidate(this.candidates[0])
      } else {
        this.imeBuffer = ''
        this.candidates = []
      }
      return
    }

    if (this.draft.length < MAX_TEXT_LENGTH) {
      this.draft += ' '
    }
  },


  backspace() {
    if (this.imeMode !== 'abc' && this.imeBuffer) {
      this.imeBuffer = this.imeBuffer.slice(0, -1)
      this.refreshCandidates()
      return
    }

    this.draft = this.draft.slice(0, -1)
  },


  clearDraft() {
    this.draft = ''
    this.imeBuffer = ''
    this.candidates = []
  },


  editNote(note) {
    if (!note || typeof note.id !== 'string') {
      return
    }

    this.mode = 'keyboard'
    this.draft = note.text
    this.imeMode = this.settings.imeMode
    this.scriptMode = this.settings.scriptMode
    this.imeBuffer = ''
    this.candidates = []
    this.editingId = note.id
    this.touchNote(note.id)
    this.deleteArmed = false
    this.status = ''
  },


  cancelEdit() {
    if (this.isSaving) {
      return
    }

    this.mode = 'memo'
    this.draft = ''
    this.imeBuffer = ''
    this.candidates = []
    this.editingId = ''
    this.deleteArmed = false
    this.status = ''
  },


  requestDelete() {
    if (this.isSaving || !this.editingId) {
      return
    }

    this.deleteArmed = true
    this.status = '再按一次確認刪除'
  },


  saveDraft() {

    if (this.isSaving) {
      return
    }

    let text = this.draft

    if (this.imeMode !== 'abc' && this.imeBuffer && this.candidates.length > 0) {
      text += this.candidates[0]
    }

    text = text.trim()

    if (!text) {
      return
    }

    const existing = this.notes.filter(note => note.id === this.editingId)[0]
    let nextNotes

    if (existing) {
      nextNotes = this.notes.map(note => {
        if (note.id !== this.editingId) {
          return note
        }

        return {
          id: note.id,
          text: text,
          time: formatTime(new Date()),
          favorite: !!note.favorite,
          lastUsed: Date.now()
        }
      })
    } else {
      const now = new Date()
      const note = {
        id: String(now.getTime()) + '-' + String(this.notes.length),
        text: text,
        time: formatTime(now),
        favorite: false,
        lastUsed: now.getTime()
      }

      nextNotes = [note].concat(this.notes).slice(0, MAX_NOTES)
    }

    this.saveNotes(nextNotes, '已儲存', 'memo')
  },


  deleteNote() {
    if (this.isSaving || !this.editingId || !this.deleteArmed) {
      return
    }

    const nextNotes = this.notes.filter(note => note.id !== this.editingId)
    this.saveNotes(nextNotes, '已刪除', 'memo')
  },


  saveNotes(nextNotes, successMessage, returnMode) {
    const self = this

    this.isSaving = true
    this.status = '儲存中…'

    storage.set({

      key: KEY,

      value: JSON.stringify(
        nextNotes
      ),

      success() {
        self.commitNotes(nextNotes)
        self.isSaving = false
        self.mode = returnMode || 'memo'
        self.draft = ''
        self.imeBuffer = ''
        self.candidates = []
        self.editingId = ''
        self.deleteArmed = false
        self.status = successMessage
      },

      fail() {
        self.isSaving = false
        self.status = '儲存失敗，請再試一次'
      }

    })

  }

}
</script>


<style>

.page {
  width: 192px;
  min-height: 490px;
  background-color: #000000;
  flex-direction: column;
}


.memo {
  padding: 24px 16px 34px;
  flex-direction: column;
}


.header,
.tools,
.key-row {
  flex-direction: row;
  align-items: center;
}


.header {
  justify-content: space-between;
  margin-bottom: 10px;
}

.search {
  width: 160px;
  height: 34px;
  padding-left: 10px;
  border-radius: 17px;
  background-color: #1d2330;
  color: #ffffff;
  font-size: 14px;
}

.filters {
  width: 160px;
  margin-top: 7px;
  margin-bottom: 8px;
  flex-direction: row;
  justify-content: space-between;
}

.filter {
  width: 50px;
  height: 28px;
  border-radius: 14px;
  background-color: #242525;
  color: #ffffff;
  font-size: 12px;
}


.title,
.note,
.typed {
  color: #ffffff;
}


.title {
  font-size: 28px;
  font-weight: bold;
}


.count,
.hint,
.time,
.status {
  color: #8e99ac;
  font-size: 14px;
}


.new-note {
  width: 160px;
  height: 42px;
  border-radius: 21px;
  font-size: 16px;
  color: #ffffff;
  background-color: #246bff;
}


.hint {
  margin-top: 20px;
  text-align: center;
}


.list {
  flex: 1;
  margin-top: 14px;
}


.item {
  padding: 10px;
  margin-bottom: 8px;
  border-radius: 12px;
  background-color: #1d2330;
  flex-direction: column;
}

.note-line {
  width: 140px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.favorite {
  width: 28px;
  height: 26px;
  border-radius: 13px;
  background-color: #343434;
  color: #ffffff;
  font-size: 15px;
}


.note {
  font-size: 18px;
}


.time {
  margin-top: 4px;
}



.header-actions {
  flex-direction: row;
  align-items: center;
}

.settings-small {
  width: 27px;
  height: 27px;
  margin-left: 5px;
  border-radius: 14px;
  background-color: #242525;
  color: #ffffff;
  font-size: 14px;
}

.settings-page {
  width: 192px;
  min-height: 490px;
  padding: 15px 16px 20px;
  flex-direction: column;
  align-items: center;
}

.settings-header {
  width: 160px;
  height: 34px;
  margin-bottom: 7px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.settings-title {
  color: #ffffff;
  font-size: 24px;
  font-weight: bold;
}

.settings-back {
  width: 48px;
  height: 28px;
  border-radius: 14px;
  background-color: #242525;
  color: #ffffff;
  font-size: 12px;
}

.setting-row {
  width: 160px;
  height: 43px;
  margin-top: 5px;
  padding: 0 8px;
  border-radius: 12px;
  background-color: #1d2330;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.setting-label {
  color: #ffffff;
  font-size: 14px;
}

.setting-action {
  width: 72px;
  height: 30px;
  border-radius: 15px;
  background-color: #246bff;
  color: #ffffff;
  font-size: 12px;
}

.setting-danger {
  background-color: #742c2c;
}

.settings-reset {
  width: 160px;
  height: 33px;
  margin-top: 8px;
  border-radius: 17px;
  background-color: #343434;
  color: #ffffff;
  font-size: 13px;
}

.about-card {
  width: 144px;
  margin-top: 9px;
  padding: 9px 8px;
  border-radius: 12px;
  background-color: #101827;
  align-items: center;
  flex-direction: column;
}

.about-name {
  color: #ffffff;
  font-size: 18px;
  font-weight: bold;
}

.about-text {
  margin-top: 3px;
  color: #8e99ac;
  font-size: 11px;
  text-align: center;
}

.keyboard-page {
  width: 192px;
  min-height: 490px;
  padding-top: 15px;
  align-items: center;
  flex-direction: column;
}

.input-box {
  width: 160px;
  height: 44px;
  padding: 6px 8px;
  border-radius: 16px;
  border-width: 2px;
  border-color: #246bff;
  background-color: #101827;
  justify-content: center;
}

.typed {
  font-size: 15px;
}

.mode-row {
  width: 160px;
  height: 30px;
  margin-top: 5px;
  justify-content: space-between;
  flex-direction: row;
}

.mode-btn,
.script-btn {
  height: 30px;
  border-radius: 15px;
  color: #ffffff;
  background-color: #242525;
  font-size: 12px;
}

.mode-btn {
  width: 44px;
}

.script-btn {
  width: 34px;
  background-color: #246bff;
}

.candidate-row {
  width: 160px;
  height: 29px;
  margin-top: 3px;
  justify-content: space-between;
  flex-direction: row;
}

.candidate {
  width: 18px;
  height: 28px;
  border-radius: 14px;
  background-color: #343434;
  color: #ffffff;
  font-size: 15px;
}

.ime-hint {
  width: 160px;
  height: 15px;
  margin-top: 1px;
  color: #8e99ac;
  font-size: 11px;
  text-align: center;
}

.tools {
  width: 160px;
  justify-content: space-between;
  margin-top: 4px;
}

.tool {
  height: 34px;
  border-radius: 17px;
  color: #ffffff;
  font-size: 14px;
}

.cancel,
.done {
  width: 50px;
  background-color: #246bff;
}

.clear {
  width: 50px;
  background-color: #e03a3a;
}

.status {
  height: 16px;
  margin-top: 1px;
  text-align: center;
}

.delete {
  width: 120px;
  height: 27px;
  margin-top: 1px;
  border-radius: 14px;
  background-color: #742c2c;
  color: #ffffff;
  font-size: 13px;
}

.confirm-delete {
  background-color: #e03a3a;
}

.keys {
  width: 192px;
  align-items: center;
