<script>
import storage from '@system.storage'

const KEY = 'band-memo.notes.v1'
const SETTINGS_KEY = 'band-memo.settings.v1'
const MAX_NOTES = 12
const MAX_BYTES = 4096
const MAX_TEXT_LENGTH = 24
const DEFAULT_CANDIDATE_LIMIT = 6
const MAX_ID_LENGTH = 64

function utf8ByteLength(value) {
  const text = String(value || '')
  let bytes = 0

  for (let i = 0; i < text.length; i += 1) {
    const code = text.charCodeAt(i)

    if (code >= 0xD800 && code <= 0xDBFF && i + 1 < text.length) {
      const next = text.charCodeAt(i + 1)
      if (next >= 0xDC00 && next <= 0xDFFF) {
        bytes += 4
        i += 1
        continue
      }
    }

    if (code <= 0x7F) {
      bytes += 1
    } else if (code <= 0x7FF) {
      bytes += 2
    } else {
      bytes += 3
    }
  }

  return bytes
}

function safeNotes(raw) {
  if (
    typeof raw !== 'string' ||
    utf8ByteLength(raw) > MAX_BYTES
  ) {
    return []
  }

  try {
    const items = JSON.parse(raw)

    if (!Array.isArray(items)) {
      return []
    }

    const ids = {}

    return items.reduce(function (result, item) {

      if (
        !item ||
        typeof item !== 'object' ||
        typeof item.id !== 'string' ||
        item.id.length < 1 ||
        item.id.length > MAX_ID_LENGTH ||
        ids[item.id]
      ) {
        return result
      }

      if (
        typeof item.text !== 'string' ||
        item.text.length < 1 ||
        item.text.length > MAX_TEXT_LENGTH
      ) {
        return result
      }

      if (
        typeof item.time !== 'string' ||
        item.time.length > 16 ||
        result.length >= MAX_NOTES
      ) {
        return result
      }

      ids[item.id] = true

      result.push({
        id: item.id,
        text: item.text,
        time: item.time,
        favorite: !!item.favorite,
        category: item.category === 'school' || item.category === 'todo' || item.category === 'work' || item.category === 'other' ? item.category : 'other',
        categoryLabel: item.category === 'school' ? '學校' : item.category === 'todo' ? '待辦' : item.category === 'work' ? '工作' : '其他',
        lastUsed: typeof item.lastUsed === 'number' ? item.lastUsed : 0
      })

      return result

    }, [])

  } catch (error) {
    return []
  }
}

function safeSettings(raw) {
  const defaults = {
    imeMode: 'abc',
    scriptMode: 'trad',
    candidateLimit: DEFAULT_CANDIDATE_LIMIT
  }

  if (typeof raw !== 'string' || !raw) {
    return defaults
  }

  try {
    const item = JSON.parse(raw)

    const imeMode = item && (
      item.imeMode === 'abc' ||
      item.imeMode === 'pinyin' ||
      item.imeMode === 'zhuyin'
    )
      ? item.imeMode
      : defaults.imeMode

    const scriptMode = item && (
      item.scriptMode === 'trad' ||
      item.scriptMode === 'simp'
    )
      ? item.scriptMode
      : defaults.scriptMode

    const candidateLimit = item && (
      item.candidateLimit === 4 ||
      item.candidateLimit === 6 ||
      item.candidateLimit === 8
    )
      ? item.candidateLimit
      : defaults.candidateLimit

    return {
      imeMode: imeMode,
      scriptMode: scriptMode,
      candidateLimit: candidateLimit
    }
  } catch (error) {
    return defaults
  }
}


function formatTime(now) {
  const month = String(now.getMonth() + 1).padStart(2, '0')
  const day = String(now.getDate()).padStart(2, '0')
  const hour = String(now.getHours()).padStart(2, '0')
  const minute = String(now.getMinutes()).padStart(2, '0')

  return month + '/' + day + ' ' + hour + ':' + minute
}


