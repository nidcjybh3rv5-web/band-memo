<template>
  <div class="page">

    <div class="memo" if="{{mode === 'memo'}}">

      <div class="header">
        <text class="title">速記</text>
        <text class="count">{{notes.length}} / 12</text>
      </div>

      <input
        class="new-note"
        type="button"
        value="＋ 新增速記"
        @click="openKeyboard"
      />

      <text
        class="hint"
        if="{{notes.length === 0}}"
      >
        點選新增，輸入你的備忘
      </text>

      <list
        class="list"
        if="{{notes.length > 0}}"
      >
        <list-item
          class="item"
          for="{{notes}}"
          type="list"
          tid="id"
          @click="editNote($item)"
        >
          <text class="note">{{$item.text}}</text>
          <text class="time">{{$item.time}}</text>
        </list-item>
      </list>

      <text class="status" if="{{status}}">{{status}}</text>

    </div>


    <div
      class="keyboard-page"
      if="{{mode === 'keyboard'}}"
    >

      <div class="input-box">
        <text class="typed">
          {{draft || '輸入備忘…'}}
        </text>
      </div>

      <div class="tools">

        <input
          class="tool cancel"
          type="button"
          value="取消"
          @click="cancelEdit"
        />

        <input
          class="tool clear"
          type="button"
          value="清除"
          @click="clearDraft"
        />

        <input
          class="tool done"
          type="button"
          value="{{isSaving ? '儲存中' : '儲存'}}"
          @click="saveDraft"
        />

      </div>

      <text
        class="status"
        if="{{status}}"
      >
        {{status}}
      </text>

      <input
        class="delete"
        type="button"
        if="{{editingId && !deleteArmed}}"
        value="刪除這則備忘"
        @click="requestDelete"
      />

      <input
        class="delete confirm-delete"
        type="button"
        if="{{editingId && deleteArmed}}"
        value="再按一次確認刪除"
        @click="deleteNote"
      />

      <div class="keys">

        <div class="key-row row-one">
          <input class="key" type="button" value="Q" @click="typeKey" />
          <input class="key" type="button" value="W" @click="typeKey" />
          <input class="key" type="button" value="E" @click="typeKey" />
          <input class="key" type="button" value="R" @click="typeKey" />
          <input class="key" type="button" value="T" @click="typeKey" />
        </div>

        <div class="key-row row-two">
          <input class="key" type="button" value="Y" @click="typeKey" />
          <input class="key" type="button" value="U" @click="typeKey" />
          <input class="key" type="button" value="I" @click="typeKey" />
          <input class="key" type="button" value="O" @click="typeKey" />
          <input class="key" type="button" value="P" @click="typeKey" />
        </div>

        <div class="key-row row-three">
          <input class="key" type="button" value="A" @click="typeKey" />
          <input class="key" type="button" value="S" @click="typeKey" />
          <input class="key" type="button" value="D" @click="typeKey" />
          <input class="key" type="button" value="F" @click="typeKey" />
          <input class="key" type="button" value="G" @click="typeKey" />
        </div>

        <div class="key-row row-four">
          <input class="key" type="button" value="H" @click="typeKey" />
          <input class="key" type="button" value="J" @click="typeKey" />
          <input class="key" type="button" value="K" @click="typeKey" />
          <input class="key" type="button" value="L" @click="typeKey" />
        </div>

        <div class="key-row row-five">
          <input class="key" type="button" value="Z" @click="typeKey" />
          <input class="key" type="button" value="X" @click="typeKey" />
          <input class="key" type="button" value="C" @click="typeKey" />
          <input class="key" type="button" value="V" @click="typeKey" />
          <input class="key" type="button" value="B" @click="typeKey" />
        </div>

        <div class="key-row row-six">
          <input class="key" type="button" value="N" @click="typeKey" />
          <input class="key" type="button" value="M" @click="typeKey" />

          <input
            class="backspace"
            type="button"
            value="⌫"
            @click="backspace"
          />
        </div>

        <input
          class="space"
          type="button"
          value="空白"
          @click="space"
        />

      </div>

    </div>

  </div>
</template>


<script>
import storage from '@system.storage'

const KEY = 'band-memo.notes.v1'
const MAX_NOTES = 12
const MAX_BYTES = 4096
const MAX_TEXT_LENGTH = 24

function safeNotes(raw) {
  if (
    typeof raw !== 'string' ||
    raw.length > MAX_BYTES
  ) {
    return []
  }

  try {
    const items = JSON.parse(raw)

    if (!Array.isArray(items)) {
      return []
    }

    const ids = {}

    return items.reduce(function (result, item) {

      if (
        !item ||
        typeof item !== 'object' ||
        typeof item.id !== 'string' ||
        ids[item.id]
      ) {
        return result
      }

      if (
        typeof item.text !== 'string' ||
        item.text.length < 1 ||
        item.text.length > MAX_TEXT_LENGTH
      ) {
        return result
      }

      if (
        typeof item.time !== 'string' ||
        item.time.length > 16 ||
        result.length >= MAX_NOTES
      ) {
        return result
      }

      ids[item.id] = true

      result.push({
        id: item.id,
        text: item.text,
        time: item.time
      })

      return result

    }, [])

  } catch (error) {
    return []
  }
}

function formatTime(now) {
  const month = String(now.getMonth() + 1).padStart(2, '0')
  const day = String(now.getDate()).padStart(2, '0')
  const hour = String(now.getHours()).padStart(2, '0')
  const minute = String(now.getMinutes()).padStart(2, '0')

  return month + '/' + day + ' ' + hour + ':' + minute
}


export default {

  private: {
    notes: [],
    mode: 'memo',
    draft: '',
    editingId: '',
    deleteArmed: false,
    isSaving: false,
    status: ''
  },


  onInit() {
    const self = this

    storage.get({
      key: KEY,
      default: '[]',

      success(data) {

        self.notes = safeNotes(
          typeof data === 'string'
            ? data
            : data && data.data
        )

      },

      fail() {
        self.notes = []
      }
    })
  },


  openKeyboard() {
    this.mode = 'keyboard'
    this.draft = ''
    this.editingId = ''
    this.deleteArmed = false
    this.status = ''
  },


  typeKey(event) {

    if (
      event &&
      typeof event.value === 'string' &&
      this.draft.length < MAX_TEXT_LENGTH
    ) {
      this.draft += event.value
    }

  },


  space() {

    if (this.draft.length < MAX_TEXT_LENGTH) {
      this.draft += ' '
    }

  },


  backspace() {
    this.draft = this.draft.slice(0, -1)
  },


  clearDraft() {
    this.draft = ''
  },


  editNote(note) {
    if (!note || typeof note.id !== 'string') {
      return
    }

    this.mode = 'keyboard'
    this.draft = note.text
    this.editingId = note.id
    this.deleteArmed = false
    this.status = ''
  },


  cancelEdit() {
    if (this.isSaving) {
      return
    }

    this.mode = 'memo'
    this.draft = ''
    this.editingId = ''
    this.deleteArmed = false
    this.status = ''
  },


  requestDelete() {
    if (this.isSaving || !this.editingId) {
      return
    }

    this.deleteArmed = true
    this.status = '再按一次確認刪除'
  },


  saveDraft() {

    if (this.isSaving) {
      return
    }

    const text = this.draft.trim()

    if (!text) {
      return
    }

    const existing = this.notes.filter(note => note.id === this.editingId)[0]
    let nextNotes

    if (existing) {
      nextNotes = this.notes.map(note => {
        if (note.id !== this.editingId) {
          return note
        }

        return {
          id: note.id,
          text: text,
          time: formatTime(new Date())
        }
      })
    } else {
      const now = new Date()
      const note = {
        id: String(now.getTime()) + '-' + String(this.notes.length),
        text: text,
        time: formatTime(now)
      }

      nextNotes = [note].concat(this.notes).slice(0, MAX_NOTES)
    }

    this.saveNotes(nextNotes, '已儲存')
  },


  deleteNote() {
    if (this.isSaving || !this.editingId || !this.deleteArmed) {
      return
    }

    const nextNotes = this.notes.filter(note => note.id !== this.editingId)
    this.saveNotes(nextNotes, '已刪除')
  },


  saveNotes(nextNotes, successMessage) {
    const self = this

    this.isSaving = true
    this.status = '儲存中…'

    storage.set({

      key: KEY,

      value: JSON.stringify(
        nextNotes
      ),

      success() {
        self.notes = nextNotes
        self.isSaving = false
        self.mode = 'memo'
        self.draft = ''
        self.editingId = ''
        self.deleteArmed = false
        self.status = successMessage
      },

      fail() {
        self.isSaving = false
        self.status = '儲存失敗，請再試一次'
      }

    })

  }

}
</script>


<style>

.page {
  width: 192px;
  min-height: 490px;
  background-color: #000000;
  flex-direction: column;
}


.memo {
  padding: 24px 16px 34px;
  flex-direction: column;
}


.header,
.tools,
.key-row {
  flex-direction: row;
  align-items: center;
}


.header {
  justify-content: space-between;
  margin-bottom: 18px;
}


.title,
.note,
.typed {
  color: #ffffff;
}


.title {
  font-size: 28px;
  font-weight: bold;
}


.count,
.hint,
.time,
.status {
  color: #8e99ac;
  font-size: 14px;
}


.new-note {
  width: 160px;
  height: 42px;
  border-radius: 21px;
  font-size: 16px;
  color: #ffffff;
  background-color: #246bff;
}


.hint {
  margin-top: 20px;
  text-align: center;
}


.list {
  flex: 1;
  margin-top: 14px;
}


.item {
  padding: 12px;
  margin-bottom: 8px;
  border-radius: 12px;
  background-color: #1d2330;
  flex-direction: column;
}


.note {
  font-size: 18px;
}


.time {
  margin-top: 4px;
}


.keyboard-page {
  width: 192px;
  min-height: 490px;
  padding-top: 22px;
  align-items: center;
  flex-direction: column;
}


.input-box {
  width: 160px;
  height: 48px;
  padding: 8px;
  border-radius: 16px;
  border-width: 2px;
  border-color: #246bff;
  background-color: #101827;
  justify-content: center;
}


.typed {
  font-size: 16px;
}


.tools {
  width: 160px;
  justify-content: space-between;
  margin-top: 10px;
}


.tool {
  height: 34px;
  border-radius: 17px;
  color: #ffffff;
  font-size: 14px;
}


.cancel,
.done {
  width: 48px;
  background-color: #246bff;
}


.clear {
  width: 48px;
  background-color: #e03a3a;
}


.status {
  height: 18px;
  margin-top: 4px;
  text-align: center;
}


.delete {
  width: 120px;
  height: 28px;
  margin-top: 2px;
  border-radius: 14px;
  background-color: #742c2c;
  color: #ffffff;
  font-size: 13px;
}


.confirm-delete {
  background-color: #e03a3a;
}


.keys {
  width: 192px;
  height: 250px;
  margin-top: 4px;
  padding-top: 8px;
  background-color: #080808;
  align-items: center;
  flex-direction: column;
}


.key-row {
  justify-content: center;
  height: 37px;
}


.key,
.backspace {
  width: 32px;
  height: 32px;
  margin-right: 2px;
  border-radius: 16px;
  background-color: #242525;
  color: #ffffff;
  font-size: 16px;
}


.backspace {
  width: 50px;
  background-color: #343434;
  font-size: 16px;
}


.space {
  width: 110px;
  height: 30px;
  margin-top: 3px;
  border-radius: 15px;
  background-color: #242525;
  color: #ffffff;
  font-size: 14px;
}

</style>
